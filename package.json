{
  "name": "sworks",
  "version": "0.1.0",
  "private": true,
  "description": "SworkS：单人、本地运行、数据优先的家教工作台——收题、整理与学生作答记录",
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "pnpm run build:web && pnpm run build:server",
    "build:web": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist/node/server/cli/start.js",
    "restore": "node dist/node/server/cli/restore.js",
    "mcp": "node dist/node/server/cli/mcp.js",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:all": "pnpm run typecheck && pnpm run test && pnpm run build && pnpm run test:e2e"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@fontsource-variable/nunito-sans": "5.3.0",
    "@fontsource/lora": "5.3.0",
    "@headless-tree/core": "1.7.0",
    "@headless-tree/react": "1.7.0",
    "@hono/node-server": "2.1.1",
    "@lezer/highlight": "1.2.4",
    "@modelcontextprotocol/server": "2.0.0",
    "@radix-ui/react-context-menu": "2.3.7",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-popover": "1.1.23",
    "@tanstack/react-query": "5.102.8",
    "better-sqlite3": "13.0.3",
    "cmdk": "1.1.1",
    "heic-decode": "2.1.0",
    "hono": "4.13.9",
    "ipaddr.js": "2.5.0",
    "katex": "0.16.47",
    "lucide-react": "1.48.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "rehype-callouts": "2.2.0",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "sharp": "0.35.4",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "yauzl": "3.4.0",
    "yazl": "3.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "@vitejs/plugin-react": "6.1.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}

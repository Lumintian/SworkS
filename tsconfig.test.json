{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node", "vite/client"],
    "noEmit": true,
    "paths": { "@shared/*": ["./src/shared/*"] }
  },
  "include": ["tests/**/*.ts", "tests/**/*.tsx"]
}
